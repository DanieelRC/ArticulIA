# Copia este archivo a .env y rellena las claves.

# --- LLM ---
# gemini | anthropic | xai
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# --- Base de datos ---
POSTGRES_USER=articulia
POSTGRES_PASSWORD=articulia
POSTGRES_DB=articulia
POSTGRES_PORT=5432
DATABASE_URL=postgresql://articulia:articulia@localhost:5432/articulia

# --- LangSmith ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=articulia
