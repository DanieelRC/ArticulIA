# Copia este archivo a .env y rellena las claves.

# --- LLM ---
# gemini | anthropic | xai
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# --- Base de datos ---
POSTGRES_USER=articulia
POSTGRES_PASSWORD=articulia
POSTGRES_DB=articulia
POSTGRES_PORT=5432
# 127.0.0.1 y no localhost: en Windows localhost resuelve primero a IPv6, que Compose no publica.
DATABASE_URL=postgresql://articulia:articulia@127.0.0.1:5432/articulia

# --- LangSmith ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=articulia

# --- Recuperación ---
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RRF_K=60
RRF_TEXT_WEIGHT=0.5
RERANK_CANDIDATES=20
RERANKER_ENABLED=true
RERANK_MAX_LENGTH=256
RERANKER_INT8=true
# Modelo ligero que recorta candidatos antes del reranker principal (vacío lo apaga)
RERANK_PREFILTER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANK_PREFILTER_KEEP=8

# --- Control de gasto y abuso ---
# production apaga /docs y exige contraseña propia de la base (ver docker-compose.prod.yml)
ENVIRONMENT=development
DAILY_BUDGET_USD=1.0
LLM_PRICE_IN_PER_M=1.0
LLM_PRICE_OUT_PER_M=2.0
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=30
MAX_CONCURRENT_AGENTS=2
ANSWER_CACHE_TTL_HOURS=168
LLM_MAX_OUTPUT_TOKENS=4000
MAX_TOKENS_PER_QUERY=40000
WARMUP_MODELS=false

# --- Interfaz y despliegue ---
# Enlace al repositorio que muestra la portada (opcional)
VITE_GITHUB_URL=
# Solo producción (docker-compose.prod.yml): dominio para el certificado HTTPS
DOMINIO=
