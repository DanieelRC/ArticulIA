// Borrador redactado con Claude Code a partir del texto vigente del corpus; revisar y ajustar.
// 60 preguntas: 38 directas, 12 que requieren dos artículos o dos leyes, 10 sin respuesta en el corpus.
// Las preguntas están en lenguaje cotidiano a propósito, sin copiar el texto de los artículos.
// --- LFT ---
{"id": "lft-vacaciones", "pregunta": "Voy a cumplir un año en mi trabajo, ¿cuántos días de vacaciones me tocan?", "tipo": "directa", "esperados": ["LFT-76"], "referencia": "Al cumplir un año de servicios corresponden por lo menos doce días laborables de vacaciones pagadas, y aumentan dos días por cada año siguiente hasta llegar a veinte."}
{"id": "lft-prima-vacacional", "pregunta": "¿Me tienen que pagar algo extra cuando salgo de vacaciones?", "tipo": "directa", "esperados": ["LFT-80"], "referencia": "Sí, una prima vacacional no menor del veinticinco por ciento sobre los salarios del periodo de vacaciones."}
{"id": "lft-aguinaldo", "pregunta": "¿Hasta qué fecha me deben pagar el aguinaldo y de cuánto es como mínimo?", "tipo": "directa", "esperados": ["LFT-87"], "referencia": "Antes del 20 de diciembre, y equivale por lo menos a quince días de salario; si no se completó el año, se paga la parte proporcional."}
{"id": "lft-jornada", "pregunta": "¿Cuántas horas me pueden poner a trabajar al día y cuántas a la semana?", "tipo": "multiple", "esperados": ["LFT-59", "LFT-61"], "referencia": "La jornada ordinaria no puede pasar de cuarenta horas semanales; al día son ocho horas la diurna, siete la nocturna y siete y media la mixta."}
{"id": "lft-horas-extra", "pregunta": "Si me quedo a trabajar horas extra, ¿cuánto me las deben pagar?", "tipo": "directa", "esperados": ["LFT-66"], "referencia": "Se pagan con un cien por ciento más que las horas ordinarias, y el tiempo extra no puede exceder de doce horas a la semana."}
{"id": "lft-domingo", "pregunta": "Me toca trabajar los domingos, ¿me deben pagar algo adicional?", "tipo": "directa", "esperados": ["LFT-71"], "referencia": "Sí, una prima de por lo menos veinticinco por ciento sobre el salario de los días ordinarios."}
{"id": "lft-dias-festivos", "pregunta": "¿Cuáles son los días festivos obligatorios y cuánto me pagan si trabajo uno de ellos?", "tipo": "multiple", "esperados": ["LFT-74", "LFT-75"], "referencia": "Entre otros, 1o. de enero, primer lunes de febrero, tercer lunes de marzo, 1o. de mayo, 16 de septiembre, tercer lunes de noviembre y 25 de diciembre; quien trabaja ese día recibe salario doble además del salario del descanso."}
{"id": "lft-periodo-prueba", "pregunta": "Entré a un trabajo nuevo, ¿cuánto tiempo puede durar el periodo de prueba?", "tipo": "directa", "esperados": ["LFT-39-A"], "referencia": "Hasta treinta días; puede extenderse hasta ciento ochenta días para puestos de dirección o labores técnicas o profesionales especializadas."}
{"id": "lft-despido-injustificado", "pregunta": "Me despidieron sin una causa justificada, ¿qué puedo exigir?", "tipo": "multiple", "esperados": ["LFT-48", "LFT-50"], "referencia": "Puede pedir la reinstalación o una indemnización de tres meses de salario, más salarios vencidos hasta por doce meses; en ciertos casos se suman veinte días de salario por año de servicios."}
{"id": "lft-maternidad", "pregunta": "Estoy embarazada, ¿cuántas semanas de descanso me corresponden?", "tipo": "directa", "esperados": ["LFT-170"], "referencia": "Seis semanas antes y seis después del parto, con la posibilidad de transferir hasta cuatro semanas previas para después del parto."}
{"id": "lft-paternidad", "pregunta": "Voy a ser papá, ¿me tienen que dar días libres en el trabajo?", "tipo": "directa", "esperados": ["LFT-132"], "referencia": "Sí, un permiso de paternidad de cinco días laborables con goce de sueldo, también en caso de adopción."}
{"id": "lft-edad-minima", "pregunta": "¿Desde qué edad puede trabajar legalmente un adolescente?", "tipo": "multiple", "esperados": ["LFT-22", "CPEUM-123"], "referencia": "Está prohibido el trabajo de menores de quince años; los mayores de quince pueden trabajar, y entre quince y dieciséis necesitan autorización de sus padres o tutores."}
{"id": "lft-prima-antiguedad", "pregunta": "Llevo dieciséis años en la empresa y quiero renunciar, ¿me toca alguna prima por antigüedad?", "tipo": "directa", "esperados": ["LFT-162"], "referencia": "Sí, quien se separa voluntariamente con al menos quince años de servicios recibe doce días de salario por cada año."}
{"id": "lft-discriminacion", "pregunta": "¿Una empresa puede rechazarme para un empleo por mi edad o mi religión?", "tipo": "multiple", "esperados": ["LFT-133", "CPEUM-1"], "referencia": "No; la LFT prohíbe negarse a aceptar trabajadores por edad, religión, género y otros criterios discriminatorios, y la Constitución prohíbe toda discriminación."}
// --- CPEUM ---
{"id": "cpeum-ciudadania", "pregunta": "¿A qué edad se es ciudadano en México?", "tipo": "directa", "esperados": ["CPEUM-34"], "referencia": "Al cumplir 18 años, siendo mexicano y teniendo un modo honesto de vivir."}
{"id": "cpeum-presidente-edad", "pregunta": "¿Cuántos años tiene que tener alguien para poder ser presidente?", "tipo": "directa", "esperados": ["CPEUM-82"], "referencia": "35 años cumplidos al tiempo de la elección, además de los otros requisitos como ser mexicano por nacimiento."}
{"id": "cpeum-presidente-periodo", "pregunta": "¿Cuánto dura el periodo de un presidente y puede volver a gobernar después?", "tipo": "directa", "esperados": ["CPEUM-83"], "referencia": "Seis años a partir del 1o. de octubre; quien haya ocupado el cargo no puede volver a desempeñarlo nunca."}
{"id": "cpeum-educacion", "pregunta": "¿La escuela pública debe ser gratuita?", "tipo": "directa", "esperados": ["CPEUM-3"], "referencia": "Sí, la educación que imparte el Estado es obligatoria, universal, inclusiva, pública, gratuita y laica."}
{"id": "cpeum-peticion", "pregunta": "Le mandé una carta a una dependencia del gobierno, ¿están obligados a responderme?", "tipo": "directa", "esperados": ["CPEUM-8"], "referencia": "Sí, a toda petición hecha por escrito, pacífica y respetuosa debe recaer un acuerdo escrito que se dé a conocer en breve término."}
{"id": "cpeum-retroactividad", "pregunta": "¿Me pueden aplicar una ley nueva por algo que hice antes de que existiera?", "tipo": "directa", "esperados": ["CPEUM-14"], "referencia": "No en perjuicio de la persona: ninguna ley tiene efecto retroactivo en perjuicio de persona alguna."}
{"id": "cpeum-nacionalidad", "pregunta": "Mi hijo nació en Estados Unidos y yo soy mexicana, ¿él es mexicano?", "tipo": "directa", "esperados": ["CPEUM-30"], "referencia": "Sí, es mexicano por nacimiento quien nace en el extranjero de madre o padre mexicanos."}
{"id": "cpeum-igualdad", "pregunta": "¿La Constitución reconoce que hombres y mujeres tienen los mismos derechos?", "tipo": "directa", "esperados": ["CPEUM-4"], "referencia": "Sí, la mujer y el hombre son iguales ante la ley y el Estado garantiza la igualdad sustantiva de las mujeres."}
// --- CCF ---
{"id": "ccf-edad-matrimonio", "pregunta": "¿A qué edad me puedo casar?", "tipo": "directa", "esperados": ["CCF-148"], "referencia": "Se necesita haber cumplido dieciocho años."}
{"id": "ccf-mayoria-edad", "pregunta": "¿Desde cuándo puedo vender mis cosas sin pedirle permiso a mis papás?", "tipo": "multiple", "esperados": ["CCF-646", "CCF-647"], "referencia": "La mayoría de edad empieza a los dieciocho años cumplidos, y el mayor de edad dispone libremente de su persona y de sus bienes."}
{"id": "ccf-alimentos-hijos", "pregunta": "¿Quién está obligado a mantener a los hijos?", "tipo": "directa", "esperados": ["CCF-303"], "referencia": "Los padres; a falta o por imposibilidad de ellos, los demás ascendientes más próximos en grado."}
{"id": "ccf-alimentos-reciproca", "pregunta": "Mis papás me mantuvieron, ¿yo estoy obligado a ayudarlos económicamente cuando lo necesiten?", "tipo": "directa", "esperados": ["CCF-301"], "referencia": "Sí, la obligación de dar alimentos es recíproca: quien los da tiene a su vez derecho de pedirlos."}
{"id": "ccf-herencia-intestada", "pregunta": "Mi papá murió sin hacer testamento, ¿quiénes heredan sus bienes?", "tipo": "directa", "esperados": ["CCF-1602"], "referencia": "Los descendientes, cónyuge, ascendientes, parientes colaterales hasta el cuarto grado y la concubina o concubinario; a falta de ellos, la beneficencia pública."}
{"id": "ccf-testamento-a-mano", "pregunta": "¿Es válido un testamento que yo escriba a mano?", "tipo": "multiple", "esperados": ["CCF-1550", "CCF-1551"], "referencia": "Sí, es el testamento ológrafo: escrito de puño y letra, firmado y fechado por una persona mayor de edad, y debe depositarse en el Archivo General de Notarías."}
{"id": "ccf-renta-minima", "pregunta": "Voy a rentar un departamento para vivir, ¿cuánto dura como mínimo el contrato?", "tipo": "directa", "esperados": ["CCF-2448-C"], "referencia": "Un año forzoso para arrendador y arrendatario, salvo convenio en contrario."}
{"id": "ccf-divorcio", "pregunta": "Después de divorciarme, ¿me puedo volver a casar?", "tipo": "directa", "esperados": ["CCF-266"], "referencia": "Sí, el divorcio disuelve el vínculo del matrimonio y deja a los cónyuges en aptitud de contraer otro."}
// --- LFPDPPP ---
{"id": "lfpdppp-sensibles", "pregunta": "¿Qué datos personales se consideran sensibles?", "tipo": "directa", "esperados": ["LFPDPPP-2"], "referencia": "Los que afectan la esfera más íntima o cuyo mal uso puede discriminar, como origen racial, estado de salud, información genética, creencias, opiniones políticas y preferencia sexual."}
{"id": "lfpdppp-consentimiento-salud", "pregunta": "¿Una empresa puede usar mis datos de salud sin que yo firme nada?", "tipo": "directa", "esperados": ["LFPDPPP-8"], "referencia": "No, los datos sensibles requieren consentimiento expreso y por escrito de la persona titular."}
{"id": "lfpdppp-aviso", "pregunta": "¿Qué debe decir el aviso de privacidad de una empresa y cuándo me lo tienen que dar?", "tipo": "multiple", "esperados": ["LFPDPPP-15", "LFPDPPP-16"], "referencia": "Debe incluir al menos la identidad y domicilio del responsable, los datos tratados y las finalidades, entre otros; se pone a disposición del titular por medios impresos, digitales u otros al obtener los datos."}
{"id": "lfpdppp-plazo", "pregunta": "Le pedí a una empresa que borre mis datos, ¿cuánto tiempo tiene para contestarme?", "tipo": "directa", "esperados": ["LFPDPPP-31"], "referencia": "Un máximo de veinte días desde que recibió la solicitud, y si procede, debe hacerla efectiva dentro de los quince días siguientes."}
{"id": "lfpdppp-acceso", "pregunta": "¿Puedo pedirle a mi banco que me diga qué datos míos tiene?", "tipo": "directa", "esperados": ["LFPDPPP-22"], "referencia": "Sí, la persona titular tiene derecho a acceder a sus datos personales y a conocer las condiciones de su tratamiento."}
{"id": "lfpdppp-seguridad", "pregunta": "¿Qué tiene que hacer una empresa para cuidar mis datos personales?", "tipo": "directa", "esperados": ["LFPDPPP-18"], "referencia": "Establecer y mantener medidas de seguridad administrativas, técnicas y físicas contra daño, pérdida, alteración o uso no autorizado."}
{"id": "lfpdppp-constitucion", "pregunta": "¿La protección de mis datos personales es un derecho constitucional y qué ley la aplica a las empresas privadas?", "tipo": "multiple", "esperados": ["CPEUM-16", "LFPDPPP-1"], "referencia": "Sí, el artículo 16 constitucional reconoce el derecho a la protección de datos personales; la LFPDPPP regula los datos en posesión de particulares."}
// --- LFDA ---
{"id": "lfda-duracion", "pregunta": "¿Cuánto tiempo después de que muere un escritor siguen protegidos sus libros?", "tipo": "directa", "esperados": ["LFDA-29"], "referencia": "Los derechos patrimoniales duran toda la vida del autor y cien años más después de su muerte."}
{"id": "lfda-registro", "pregunta": "¿Tengo que registrar mi canción para que esté protegida?", "tipo": "directa", "esperados": ["LFDA-5"], "referencia": "No, la protección existe desde que la obra se fija en un soporte material y no requiere registro."}
{"id": "lfda-derechos-morales", "pregunta": "Si vendo los derechos de mi novela, ¿dejo de ser reconocido como su autor?", "tipo": "multiple", "esperados": ["LFDA-18", "LFDA-19"], "referencia": "No, el autor es el titular perpetuo de los derechos morales, que son inalienables, imprescriptibles e irrenunciables."}
{"id": "lfda-cita-tesis", "pregunta": "¿Puedo poner fragmentos de un libro en mi tesis sin pedir permiso?", "tipo": "directa", "esperados": ["LFDA-148"], "referencia": "Sí, se pueden citar textos de obras ya divulgadas sin autorización ni pago, citando siempre la fuente, sin alterar la obra y sin reproducir una parte sustancial."}
{"id": "lfda-software", "pregunta": "¿El código que escribo está protegido por derechos de autor?", "tipo": "multiple", "esperados": ["LFDA-101", "LFDA-102"], "referencia": "Sí, los programas de computación se protegen en los mismos términos que las obras literarias, en código fuente o código objeto."}
{"id": "lfda-software-empleado", "pregunta": "Programé una app para la empresa donde trabajo, ¿de quién son los derechos?", "tipo": "directa", "esperados": ["LFDA-103"], "referencia": "Salvo pacto en contrario, los derechos patrimoniales corresponden al empleador."}
// --- LFPC ---
{"id": "lfpc-garantia", "pregunta": "¿Cuánto debe durar como mínimo la garantía de algo que compré?", "tipo": "directa", "esperados": ["LFPC-77"], "referencia": "No puede ser inferior a noventa días contados a partir de la entrega del bien o la prestación del servicio."}
{"id": "lfpc-no-es-lo-que-ofrecieron", "pregunta": "Compré algo que no era lo que me ofrecieron o salió con defectos ocultos, ¿pueden devolverme mi dinero?", "tipo": "multiple", "esperados": ["LFPC-92", "LFPC-82"], "referencia": "Sí, se puede elegir la reposición del producto o la devolución de lo pagado, además de una bonificación; con vicios ocultos también procede la rescisión o la reducción del precio."}
{"id": "lfpc-venta-domicilio", "pregunta": "Firmé una compra con un vendedor que vino a mi casa, ¿todavía me puedo arrepentir?", "tipo": "directa", "esperados": ["LFPC-56"], "referencia": "Sí, durante cinco días hábiles desde la entrega o la firma se puede revocar el consentimiento sin responsabilidad."}
{"id": "lfpc-publicidad", "pregunta": "Un anuncio exageró lo que hace un producto, ¿eso está permitido?", "tipo": "directa", "esperados": ["LFPC-32"], "referencia": "No, la publicidad debe ser veraz, comprobable y clara, sin descripciones que induzcan a error por engañosas o abusivas."}
{"id": "lfpc-respetar-precio", "pregunta": "En la tienda anunciaban un precio y en la caja me cobraron más, ¿tienen que respetar el precio?", "tipo": "directa", "esperados": ["LFPC-7"], "referencia": "Sí, el proveedor está obligado a informar y respetar los precios y condiciones que ofreció."}
{"id": "lfpc-profeco", "pregunta": "¿Qué puede hacer la Profeco por mí como consumidor?", "tipo": "directa", "esperados": ["LFPC-24"], "referencia": "Entre sus atribuciones está promover y proteger los derechos del consumidor y representar sus intereses ante autoridades y proveedores."}
{"id": "lfpc-reparacion", "pregunta": "Llevé mi celular a reparar y al mes volvió a fallar por culpa de la reparación, ¿qué puedo exigir?", "tipo": "directa", "esperados": ["LFPC-81"], "referencia": "Dentro de los noventa días naturales siguientes a la entrega, que se repare de nuevo sin costo alguno."}
